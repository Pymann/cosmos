# /etc/cosmos/cosmos.env — Ports und Adressen der drei cosmos-Dienste
# (doc/spec/112).  KEIN Geheimnis hier: die Datei ist fuer Pipeline-Schritte
# lesbar (sie sehen /etc des Wirts, F112-2).  Leer = Vorgaben der Einheiten:
#
#   cosmosd       ws://127.0.0.1:8770     (nur lokal; der Agent wohnt auf demselben Rechner)
#   cosmos-api    127.0.0.1:8771          (HTTP ohne TLS — nie auf 0.0.0.0, F112-4)
#
# Wer einen Port aendert, aendert ihn fuer ALLE: cosmosd, Gateway und Agent
# lesen diese Datei.  Danach: sudo systemctl restart cosmosd cosmos-api cosmos-agent
#
#COSMOS_BIND=ws://127.0.0.1:8770
#COSMOS_API_UPSTREAM=ws://127.0.0.1:8770
#COSMOS_AGENT_URL=ws://127.0.0.1:8770
#COSMOS_API_PORT=8771
#COSMOS_AGENT_ID=kontor-server
#COSMOS_AGENT_LABELS=kontor-server,x86_64,linux
