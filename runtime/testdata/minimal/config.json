{
  "ociVersion": "1.0.2",
  "process": {
    "terminal": false,
    "user": { "uid": 0, "gid": 0 },
    "args": [ "/bin/sh", "-c", "echo hallo" ],
    "env": [ "PATH=/usr/bin:/bin", "TERM=xterm" ],
    "cwd": "/",
    "noNewPrivileges": true
  },
  "root": { "path": "rootfs", "readonly": true },
  "hostname": "cosmos-rt",
  "mounts": [
    { "destination": "/proc", "type": "proc", "source": "proc", "options": [ "nosuid", "noexec", "nodev" ] },
    { "destination": "/tmp", "type": "tmpfs", "source": "tmpfs", "options": [ "nosuid", "nodev", "mode=1777" ] }
  ],
  "linux": {
    "namespaces": [
      { "type": "pid" }, { "type": "mount" }, { "type": "user" }, { "type": "ipc" }, { "type": "uts" }
    ],
    "maskedPaths": [ "/proc/sysrq-trigger", "/sys/firmware" ],
    "readonlyPaths": [ "/proc/bus", "/proc/sys" ]
  }
}
