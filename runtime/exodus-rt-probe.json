{
    "$schema": "exodus.project.config-1.0",
    "name": "rt_probe",
    "version": "0.1.0",
    "output_type": "executable",
    "sources": [
        "sources/runtime/rt_probe.aiml"
    ],
    "compiler": {
        "name": "$AIML",
        "lang_standard": "17",
        "flags": []
    },
    "linker": {
        "name": "g++",
        "libraries": [
            "rt_shim",
            "aiml",
            "pthread",
            "dl"
        ],
        "library_paths": [
            "runtime/shim",
            "$AIML_VENV/lib"
        ],
        "flags": [
            "-Wl,-rpath,$ORIGIN/../lib:$ORIGIN/runtime/shim"
        ]
    },
    "artifact_in_cwd": true,
    "optimization": "0",
    "debug": true,
    "env": {
        "AIML_MEM_V3": "1"
    }
}
