# Secrets for steps without network and without an agent (doc/spec/115).
#
#   - the masker (sources/shared/secret_mask.aiml): what it hides, longest
#     first, base64, the Basic form, key lines, and where a chunk may end
#     (A115-2, F115-15/16/18);
#   - the declaration: kinds read, unknown kinds and foreign fields refused
#     (F115-1/22);
#   - submit and claim: names stored, values resolved at claim, an
#     undeclared or short secret refused (A115-5, F115-12/13);
#   - the agent's files: beside the step directory, 0400, sourced by sh,
#     gone after (A115-3/4, F115-10/11).
# Expected exit code: 0

- import: "sources/shared/secret_mask.aiml"
- import: "sources/server/casc_reader.aiml"
- import: "sources/server/secret_kinds.aiml"
- import: "sources/server/stage_secrets.aiml"
- import: "sources/server/stage_keys.aiml"
- import: "sources/server/pipeline_submit.aiml"
- import: "sources/agent/agent_secrets.aiml"
- import: "sources/server/run_store.aiml"

- def:
    name: expect
    args: [[what, string], [cond, i32]]
    return: i32
    body:
      - if:
          condition: { eq: [cond, 1] }
          then: [{ call: [log.info, "  ok   ${what}"] }, { return: 0 }]
      - call: [log.info, "  FAIL ${what}"]
      - return: 1

- def:
    name: mask_case
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [mask, cosmos.secrets.SecretMask]
      - call: [mask.add, "hunter2-long"]
      - call: [mask.add, "hunter"]
      - call: [mask.add, "abc"]
      - set: [fails, { +: [fails, { call: [expect, "a value under 4 bytes is not taken (F115-13)", { eq: [{ call: [mask.apply, "abc"] }, "abc"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "longest first: no half-masked value (F115-15)", { eq: [{ call: [mask.apply, "pw=hunter2-long."] }, "pw=****."] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the shorter one alone", { eq: [{ call: [mask.apply, "x hunter y"] }, "x **** y"] }] }] }]
      - decl: [b64, string, { call: [base64.encode, "hunter2-long"] }]
      - set: [fails, { +: [fails, { call: [expect, "its base64 too (F115-18)", { eq: [{ call: [mask.apply, "Bearer ${b64}"] }, "Bearer ****"] }] }] }]
      - call: [mask.add_pair, "deployer", "hunter2-long"]
      - decl: [basic, string, { call: [base64.encode, "deployer:hunter2-long"] }]
      - set: [fails, { +: [fails, { call: [expect, "the HTTP Basic form of user:password", { eq: [{ call: [mask.apply, "Authorization: Basic ${basic}"] }, "Authorization: Basic ****"] }] }] }]
      # A key: lines of 16 bytes or more, not the armour.
      - decl: [keym, cosmos.secrets.SecretMask]
      - call: [keym.add, "-----BEGIN KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC\nshort\n-----END KEY-----\n"]
      - set: [fails, { +: [fails, { call: [expect, "a key's body line is masked", { eq: [{ call: [keym.apply, "x MIIEvQIBADANBgkqhkiG9w0BAQEFAASC y"] }, "x **** y"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "its armour and short lines are not", { eq: [{ call: [keym.apply, "-----BEGIN KEY----- short"] }, "-----BEGIN KEY----- short"] }] }] }]
      # Chunk ends (F115-16).
      - decl: [cutm, cosmos.secrets.SecretMask]
      - call: [cutm.put, "SECRETVALUE"]
      - decl: [text, string, "aaaaaaaaaaaaaaaaaaaaSECRETVAL"]
      - decl: [cut, i32, { call: [cutm.safe_cut, text, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "a value that may go on is held back", { le: [cut, 20] }] }] }]
      - decl: [text2, string, "aaaaaaaaaaSECRETVALUEbbbbbbbbbbbbbbbbbbbb"]
      - decl: [cut2, i32, { call: [cutm.safe_cut, text2, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "a whole value before the cut is sent", { eq: [cut2, 31] }] }] }]
      - decl: [text3, string, "aaaaaaaaaaaaaaaaaaaaaaaaaSECRETVALUEbbbbbb"]
      - decl: [cut3, i32, { call: [cutm.safe_cut, text3, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "a value crossing the cut moves it to its start", { eq: [cut3, 25] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "at the end of the stream everything goes", { eq: [{ call: [cutm.safe_cut, text, 1] }, text.len] }] }] }]
      # Read back after a restart (F115-20).
      - decl: [back, cosmos.secrets.SecretMask]
      - call: [back.from_text, { call: [mask.to_text] }]
      - set: [fails, { +: [fails, { call: [expect, "masks read back mask the same", { eq: [{ call: [back.apply, "pw=hunter2-long Basic ${basic}"] }, "pw=**** Basic ****"] }] }] }]
      - return: fails

- def:
    name: casc_text
    return: { type: string, lifetime: producer }
    body:
      - return: "- config:\n    secrets:\n      - secret: { name: tok, file: sec/tok }\n      - secret: { name: deploy, kind: user_password, user: deployer, file: sec/pw }\n      - secret: { name: sign, kind: file, file: sec/sign }\n      - secret: { name: ssh, kind: ssh_key, file: sec/key, user: git, passphrase: pp, known_hosts: sec/kh }\n      - secret: { name: pp, file: sec/pp }\n      - secret: { name: tiny, file: sec/tiny }\n"

- def:
    name: bad_text
    return: { type: string, lifetime: producer }
    body:
      - return: "- config:\n    secrets:\n      - secret: { name: one, kind: password, file: x }\n      - secret: { name: two, cert: c.pem, file: x }\n      - secret: { name: three, kind: user_password, file: x }\n      - secret: { name: four, kind: ssh_key, passphrase: nope, file: x }\n"

- def:
    name: read_case
    static_off: ["str_cmp", "same_arg"]
    args: [[work, string]]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [reader, CascReader]
      - call: [reader.set_root, work]
      - decl: [doc, CascDoc, { call: [reader.read_text, { call: [casc_text] }] }]
      - set: [fails, { +: [fails, { call: [expect, "a good declaration reads without errors", { eq: [doc.errors.len, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "every secret has its kind entry", { eq: [doc.kinds.kinds.len, 6] }] }] }]
      - decl: [first, SecretKind, { at: [doc.kinds.kinds, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "no kind: is a token (F115-1)", { eq: [first.kind, "token"] }] }] }]
      - decl: [ssh, SecretKind, { at: [doc.kinds.kinds, 3] }]
      - set: [fails, { +: [fails, { call: [expect, "known_hosts lies beside the declaration (F115-5)", { eq: [ssh.known_hosts, "${work}/sec/kh"] }] }] }]
      - decl: [bad, CascDoc, { call: [reader.read_text, { call: [bad_text] }] }]
      - decl: [all_err, string, ""]
      - decl: [eix, i32, 0]
      - while:
          condition: { lt: [eix, bad.errors.len] }
          body:
            - set: [all_err, "${all_err}${{ at: [bad.errors, eix] }}\n"]
            - set: [eix, { +: [eix, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "an unknown kind is an error (F115-22)", { ge: [{ call: [all_err.index_of, "kind 'password' is unknown"] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "a field of another kind is an error", { ge: [{ call: [all_err.index_of, "'cert:' does not belong to kind token"] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "user_password needs user:", { ge: [{ call: [all_err.index_of, "needs 'user:'"] }, 0] }] }] }]
      # check: a passphrase names a declared secret (F115-3).
      - decl: [kinds, SecretKinds]
      - decl: [db_p, path, "${work}/db"]
      - call: [kinds.init, db_p]
      - decl: [plan, CascPlan]
      - call: [kinds.check, bad.kinds, bad.config.secrets, plan]
      - set: [fails, { +: [fails, { call: [expect, "an undeclared passphrase is a plan error", { eq: [plan.errors.len, 1] }] }] }]
      - decl: [empty, SecretKindSet]
      - call: [kinds.apply, empty]
      - decl: [plan2, CascPlan]
      - call: [kinds.plan, doc.kinds, plan2]
      - set: [fails, { +: [fails, { call: [expect, "the non-token kinds are planned as changes (F115-21)", { eq: [plan2.changes.len, 3] }] }] }]
      - return: fails

- def:
    name: pipe_src
    return: { type: string, lifetime: producer }
    body:
      - return: "- pipeline:\n    name: hochladen\n    cache: pure\n    params:\n      - [arch, string, [x86_64, arm64]]\n    secrets:\n      - { name: tok, env: TOKEN }\n    steps:\n      - stage:\n          name: bauen\n          run: \"make\"\n      - stage:\n          name: senden\n          secrets:\n            - { name: deploy, env: DEPLOY }\n          run: \"curl -u $DEPLOY_USER:$DEPLOY_PASSWORD https://example.org\"\n"

- def:
    name: bind_case
    static_off: ["str_cmp", "same_arg"]
    args: [[work, string]]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [reader, CascReader]
      - call: [reader.set_root, work]
      - decl: [doc, CascDoc, { call: [reader.read_text, { call: [casc_text] }] }]
      - decl: [kinds, SecretKinds]
      - decl: [db_p, path, "${work}/db"]
      - call: [kinds.init, db_p]
      - call: [kinds.apply, doc.kinds]
      - decl: [keys, StageKeyStore]
      - call: [keys.init]
      - decl: [store, StageSecretStore]
      - call: [store.init]
      - decl: [submit, PipelineSubmit]
      - call: [submit.declare_in, { call: [pipe_src] }, "", "rq", keys, store]
      - set: [fails, { +: [fails, { call: [expect, "submit stores names per lane and stage", { eq: [{ call: [store.binds_of, "rq-1-1"] }, "tok:TOKEN,deploy:DEPLOY"] }] }] }]
      - decl: [opaque, CacheClaim, { call: [keys.claim_of, "rq-0-1", ""] }]
      - set: [fails, { +: [fails, { call: [expect, "a stage with secrets is not reused (A115-7)", { eq: [opaque.cache_class, 0] }] }] }]
      - decl: [got, StepSecretSet, { call: [store.bind, { call: [store.binds_of, "rq-0-1"] }, doc.config.secrets, kinds] }]
      - set: [fails, { +: [fails, { call: [expect, "both bound", { '&&': [{ eq: [got.error.len, 0] }, { eq: [got.items.len, 2] }] }] }] }]
      - decl: [dep, StepSecret, { at: [got.items, 1] }]
      - set: [fails, { +: [fails, { call: [expect, "user_password with its user and the trimmed value", { '&&': [{ eq: [dep.user, "deployer"] }, { eq: [dep.value, "hunter2-long"] }] }] }] }]
      - decl: [ssh, StepSecretSet, { call: [store.bind, "ssh:GIT_SSH", doc.config.secrets, kinds] }]
      - decl: [key, StepSecret, { at: [ssh.items, 0] }]
      - set: [fails, { +: [fails, { call: [expect, "ssh_key: the key whole, passphrase and known_hosts read", { '&&': [{ eq: [key.value, "-----BEGIN KEY-----\nAAAAB3NzaC1yc2EAAAADAQABAAABAQ\n-----END KEY-----\n"] }, { '&&': [{ eq: [key.passphrase, "open-sesame"] }, { eq: [key.known_hosts, "github.com ssh-ed25519 AAAA\n"] }] }] }] }] }]
      - decl: [none, StepSecretSet, { call: [store.bind, "nope:NOPE", doc.config.secrets, kinds] }]
      - set: [fails, { +: [fails, { call: [expect, "an undeclared secret is refused by name (A115-5)", { ge: [{ call: [none.error.index_of, "secret 'nope'"] }, 0] }] }] }]
      - decl: [tiny, StepSecretSet, { call: [store.bind, "tiny:TINY", doc.config.secrets, kinds] }]
      - set: [fails, { +: [fails, { call: [expect, "a value under 4 bytes is refused (F115-13)", { ge: [{ call: [tiny.error.index_of, "shorter than 4 bytes"] }, 0] }] }] }]
      - return: fails

- def:
    name: files_case
    static_off: ["str_cmp", "same_arg"]
    args: [[work, string]]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [items, list<StepSecret>]
      - decl: [tok, StepSecret]
      - set: [tok.env, "TOKEN"]
      - set: [tok.kind, "token"]
      - set: [tok.value, "it's-a-token"]
      - call: [items.push, tok]
      - decl: [dep, StepSecret]
      - set: [dep.env, "DEPLOY"]
      - set: [dep.kind, "user_password"]
      - set: [dep.user, "deployer"]
      - set: [dep.value, "hunter2-long"]
      - call: [items.push, dep]
      - decl: [sig, StepSecret]
      - set: [sig.env, "SIGN"]
      - set: [sig.kind, "file"]
      - set: [sig.value, "line one\nline two\n"]
      - call: [items.push, sig]
      - decl: [step_dir, string, "${work}/run/run-0-1"]
      - decl: [step_p, path, step_dir]
      - call: [io.mkdir_all, step_p]
      - decl: [files, StepSecretFiles]
      - decl: [mask, cosmos.secrets.SecretMask]
      - decl: [env_file, string, { call: [files.lay_out, step_dir, items, mask] }]
      - set: [fails, { +: [fails, { call: [expect, "the env file lies beside the step directory (F115-11)", { eq: [env_file, "${step_dir}.secrets/env"] }] }] }]
      - decl: [argv, list<string>, ["/bin/sh", "-c", ". '${env_file}' && printf '%s|%s|%s|' \"$TOKEN\" \"$DEPLOY_USER\" \"$DEPLOY_PASSWORD\" && cat \"$SIGN\" && stat -c %a \"$SIGN\" '${env_file}' '${step_dir}.secrets'"]]
      - decl: [proc, process, { call: [sys.exe, argv, { capture: true, timeout: 20000 }] }]
      - call: [proc.wait]
      - decl: [said, string, proc.stdout_buffer]
      - set: [fails, { +: [fails, { call: [expect, "sourced: token (with a quote), user and password (A115-3)", { eq: [{ call: [said.starts_with, "it's-a-token|deployer|hunter2-long|line one\nline two\n"] }, 1] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "files 0400, the directory 0700 (A115-4)", { ge: [{ call: [said.index_of, "400\n400\n700"] }, 0] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "the masker knows the values", { eq: [{ call: [mask.apply, "x hunter2-long it's-a-token"] }, "x **** ****"] }] }] }]
      - decl: [back, cosmos.secrets.SecretMask]
      - set: [fails, { +: [fails, { call: [expect, "masks can be read back after a restart (F115-20)", { eq: [{ call: [files.restore, step_dir, back] }, 1] }] }] }]
      - call: [files.remove, step_dir]
      - decl: [sec_p, path, "${step_dir}.secrets"]
      - set: [fails, { +: [fails, { call: [expect, "removed after the step (A115-4)", { eq: [{ call: [io.is_dir, sec_p] }, false] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "no directory: nothing to restore", { eq: [{ call: [files.restore, step_dir, back] }, 0] }] }] }]
      - return: fails

# The server's own net (F115-17): masks per stage, before append and forward.
- def:
    name: server_case
    static_off: ["str_cmp", "same_arg"]
    args: [[work, string]]
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [mask, cosmos.secrets.SecretMask]
      - call: [mask.add, "hunter2-long"]
      - decl: [runs, RunStore]
      - call: [runs.init, "${work}/run_logs"]
      - call: [runs.set_masks, "rs-0-0", { call: [mask.to_text] }]
      - set: [fails, { +: [fails, { call: [expect, "the server masks a chunk of that stage", { eq: [{ call: [runs.masked, "rs-0-0", "pw hunter2-long"] }, "pw ****"] }] }] }]
      - set: [fails, { +: [fails, { call: [expect, "and not another stage's", { eq: [{ call: [runs.masked, "rs-0-1", "pw hunter2-long"] }, "pw hunter2-long"] }] }] }]
      - call: [runs.finish, "rs-0-0", 0]
      - set: [fails, { +: [fails, { call: [expect, "the masks go with the report", { eq: [{ call: [runs.masked, "rs-0-0", "hunter2-long"] }, "hunter2-long"] }] }] }]
      - return: fails

- def:
    name: main
    return: i32
    body:
      - decl: [fails, i32, 0]
      - decl: [probe_mask, ptr<cosmos.secrets.SecretMask>, { new: cosmos.secrets.SecretMask }]
      - call: [probe_mask.clear]
      - call: [free, probe_mask]
      - decl: [work, string, "secrets_work"]
      - decl: [work_p, path, work]
      - if: { condition: { eq: [{ call: [io.is_dir, work_p] }, true] }, then: [{ call: [io.remove_all, work_p] }] }
      - decl: [sec_p, path, "${work}/sec"]
      - call: [io.mkdir_all, sec_p]
      - call: [io.write_file, "${work}/sec/tok", "tok-value-1\n"]
      - call: [io.write_file, "${work}/sec/pw", "hunter2-long\n"]
      - call: [io.write_file, "${work}/sec/sign", "signing file\n"]
      - call: [io.write_file, "${work}/sec/key", "-----BEGIN KEY-----\nAAAAB3NzaC1yc2EAAAADAQABAAABAQ\n-----END KEY-----\n"]
      - call: [io.write_file, "${work}/sec/pp", "open-sesame\n"]
      - call: [io.write_file, "${work}/sec/kh", "github.com ssh-ed25519 AAAA\n"]
      - call: [io.write_file, "${work}/sec/tiny", "ab\n"]
      - call: [log.info, "masker"]
      - set: [fails, { +: [fails, { call: [mask_case] }] }]
      - call: [log.info, "declaration"]
      - set: [fails, { +: [fails, { call: [read_case, work] }] }]
      - call: [log.info, "submit and claim"]
      - set: [fails, { +: [fails, { call: [bind_case, work] }] }]
      - call: [log.info, "server net"]
      - set: [fails, { +: [fails, { call: [server_case, work] }] }]
      - call: [log.info, "agent files"]
      - set: [fails, { +: [fails, { call: [files_case, work] }] }]
      - if: { condition: { gt: [fails, 0] }, then: [{ call: [log.info, "${fails} check(s) FAILED"] }, { return: 1 }] }
      - call: [log.info, "all step secret checks PASS"]
      - return: 0
