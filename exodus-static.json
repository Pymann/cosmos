{
  "jobs": 16,
  "$schema": "exodus.project.config-1.0",
  "name": "static",
  "version": "0.0.1",
  "output_type": "executable",
  "sources": [
    "sources/client/web/static_main.aiml"
  ],
  "compiler": {
    "name": "$AIML",
    "lang_standard": "17",
    "flags": []
  },
  "linker": {
    "name": "g++",
    "flags": [
      "-Wl,-rpath,$ORIGIN/../lib"
    ],
    "libraries": [
      "aiml",
      "pthread",
      "ssl",
      "crypto",
      "dl"
    ],
    "library_paths": [
      "$AIML_VENV/lib"
    ]
  },
  "artifact_in_cwd": true,
  "optimization": "0",
  "debug": false,
  "warnings": [],
  "env": {
    "AIML_STRICT_TOPLEVEL": "1",
    "AIML_LIFETIME_DROPS": "1",
    "AIML_MEM_V3": "1"
  }
}