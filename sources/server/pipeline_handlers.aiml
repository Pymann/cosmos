# RPC "run_pipeline" (doc/spec/96 §96.13) — der Startknopf aus §98.
#
# Drei Schritte in dieser Reihenfolge, und die Reihenfolge ist die Aussage:
# pruefen, ausfalten, erst dann anlegen.  Scheitert die Pruefung, entsteht KEIN
# Lauf (F96-30) — eine Zeile, die nie laufen kann, muesste jemand aufraeumen.
#
# Der Quelltext wird NICHT ausgefuehrt (F96-28): fremde Schritte laufen auf
# einem Agenten, nie im Controller-Prozess.  Der Controller liest ihn nur.

- import: "sources/models/pipeline_reqs.aiml"

- groupmethods:
    group: CosmosRuntime
    instances:
      - instance: run_pipeline
        methods:
          - def:
              name: run
              static_off: ["str_cmp"]
              args: [[rpc, rpc_event], [session, mirror_session]]
              body:
                - decl: [req, PipelineSubmitReq]
                - decl: [res, PipelineSubmitResp]
                - set: [res.accepted, 0]
                - set: [res.lane_count, 0]
                - if:
                    condition: { neq: [{ call: [session.decode_rpc, rpc, req] }, 0] }
                    then:
                      - set: [res.message, "unlesbare Anfrage"]
                      - call: [session.reply_rpc, rpc, "set_result", 0, res]
                      - return: []
                # F96-33: authentifiziert wie pause_run/resume_run.  Die Antwort
                # nennt keinen Grund, der einem Unbefugten etwas verraet.
                - decl: [pid, string, { call: [<.auth.pid_for_token, req.token] }]
                - if:
                    condition: { eq: [pid.len, 0] }
                    then:
                      - set: [res.message, "nicht angemeldet"]
                      - call: [session.reply_rpc, rpc, "set_result", 0, res]
                      - return: []
                # Stufe 1: Struktur (F96-29).
                - decl: [chk, SubmitCheck, { call: [<.submitter.check, req.source, ""] }]
                - set: [res.message, chk.message]
                - set: [res.lane_count, chk.lane_count]
                - if:
                    condition: { eq: [chk.accepted, 0] }
                    then:
                      - call: [log.info, "[run_pipeline] abgelehnt: ${chk.message}"]
                      - call: [session.reply_rpc, rpc, "set_result", 0, res]
                      - return: []
                # Kennung aus der Uhr: ein Lauf je Millisekunde genuegt, und sie
                # ist ohne Zaehlerzustand eindeutig genug fuer diesen Schritt.
                - decl: [stamp, i64, { call: [time.now] }]
                - decl: [run_id, string, "run-${stamp}"]
                - decl: [run, PipelineRun, { call: [<.submitter.expand, req.source, run_id, ""] }]
                - if:
                    condition: { eq: [run.run_id.len, 0] }
                    then:
                      - set: [res.message, "Ausfaltung fehlgeschlagen"]
                      - call: [session.reply_rpc, rpc, "set_result", 0, res]
                      - return: []
                - call: [<.cluster.add_pipeline, run]
                # Der UNTERBAU gehoert zum Lauf, nicht zur Stufe (aiml spec/62
                # §18.4): er entscheidet, welches Dateisystem ALLE seine
                # Stufen sehen.
                - call: [<.cluster.set_base, run_id, { call: [<.submitter.base_in, req.source, ""] }]
                # doc/spec/96 §96.6: which stages may come out of the step cache.
                - call: [<.submitter.declare_in, req.source, "", run_id, <.cluster.keys, <.cluster.secrets]
                - set: [res.accepted, 1]
                - set: [res.run_id, run_id]
                - set: [res.message, "${chk.lane_count} Lanes, ${run.stages.len} Eintraege — angelegt als ${run_id}"]
                - call: [log.info, "[run_pipeline] ${run_id} von pid=${pid}: ${chk.lane_count} Lanes"]
                - call: [session.reply_rpc, rpc, "set_result", 0, res]
