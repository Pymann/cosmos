# PipelineSubmit — eingereichten Pipeline-Quelltext PRUEFEN LASSEN und lesen
# (doc/spec/96 §96.13, aiml spec/62 §20).
#
# Der Controller liest keine aiml-Knoten mehr.  Er gibt den Quelltext in einen
# Compiler-Kontext (aiml spec/29_2 §14a/§14b), laesst ihn uebersetzen und liest
# die entstandene Pipeline als WERT.  Vorher taten das zwei Programme: der
# Uebersetzer und diese Datei (180 `yaml.*`-Aufrufe).  Zwei Leser derselben
# Sprache laufen auseinander, und zwar leise — ein Schluessel, den der eine
# kennt und der andere nicht, ist entweder still wirkungslos oder abgelehnt
# ohne Grund (aiml F62-150).
#
# AUSGEFUEHRT wird dabei nichts: `cx.load` uebersetzt und haengt ein, ruft aber
# keinen Einstiegspunkt (aiml F29_2-…n).  Damit bleibt F96-28 gewahrt — ein
# Schritt-Rumpf laeuft beim Agenten, nicht hier.  Was hier laeuft, ist der vom
# Uebersetzer ERZEUGTE Erbauer `<name>()`, der nur `pipeline`/`stage`-Werte
# zusammensetzt (aiml F62-108).
#
# Geprueft wird hier nur noch die LAGE (aiml §20.2): kennt dieser Cluster das
# Abbild?  Die FORM — Schluessel, Achsen, Verweise, Widerspruechliches —
# gehoert dem Uebersetzer, und seine Meldung geht unveraendert an den
# Einreicher (`cx.errors`, F29_2-…l).
#
# Ausgefaltet wird BEIM EINREICHEN (F96-31): danach ist der Lauf ohne den
# Quelltext lesbar — die Oberflaeche zeigt die Matrix, die Zuteilung braucht
# nur noch die Liste.

- import: "sources/models/pipeline_submit.aiml"
- import: "sources/shared/pipeline_run.aiml"
- import: "sources/shared/job_params.aiml"

# LOCAL TEST STUB — never committed.  The real file needs aiml features
# (ctx.new, pipeline introspection) that are not on GitHub mem-v3-compiler yet.
# check/expand accept any source whose first line is "# pipeline: <name>" and
# produce a one-stage run, so the control plane around it can be exercised.
- class:
    name: PipelineSubmit
    members:
      - [last_error, string, ""]
    methods:
      - def:
          name: name_of
          access: public
          args: [[source, string]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [lines, list<string>, { call: [source.split, "\n"] }]
            - if: { condition: { eq: [lines.len, 0] }, then: [{ return: "" }] }
            - decl: [first, string, { at: [lines, 0] }]
            - if: { condition: { neq: [{ call: [first.starts_with, "# pipeline: "] }, 1] }, then: [{ return: "" }] }
            - return: { call: [first.substr, 12] }
      - def:
          name: check
          access: public
          args: [[source, string], [prm_src, string]]
          return: { type: SubmitCheck, lifetime: producer }
          body:
            - decl: [out, SubmitCheck]
            - decl: [pname, string, { call: [<.name_of, source] }]
            - if:
                condition: { eq: [pname.len, 0] }
                then:
                  - set: [out.message, "stub: erste Zeile muss '# pipeline: <name>' sein"]
                  - return: out
            - set: [out.accepted, 1]
            - set: [out.name, pname]
            - set: [out.lane_count, 1]
            - set: [out.stage_count, 1]
            - set: [out.message, "stub ok"]
            - return: out
      - def:
          name: expand
          access: public
          args: [[source, string], [run_id, string], [prm_src, string]]
          return: { type: PipelineRun, lifetime: producer }
          body:
            - decl: [run, PipelineRun]
            - decl: [pname, string, { call: [<.name_of, source] }]
            - if: { condition: { eq: [pname.len, 0] }, then: [{ return: run }] }
            - set: [run.run_id, run_id]
            - set: [run.pipeline_name, pname]
            - set: [run.status, "queued"]
            - set: [run.started_ms, { call: [time.now] }]
            - decl: [stg, PipelineStage]
            - set: [stg.name, "build"]
            - set: [stg.status, "pending"]
            - call: [run.stages.push, stg]
            - return: run
      - def:
          name: base_in
          access: public
          args: [[source, string], [prm_src, string]]
          return: { type: string, lifetime: producer }
          body: [{ return: "" }]
      - def:
          name: prm_bundle
          access: public
          args: [[bag, ref<JobParams>], [run_id, string]]
          return: { type: string, lifetime: producer }
          body: [{ return: "" }]
      - def:
          name: param_problem
          access: public
          args: [[bag, ref<JobParams>]]
          return: { type: string, lifetime: producer }
          body: [{ return: "" }]
      - def:
          name: known_image
          access: public
          args: [[name, string]]
          return: i32
          body: [{ return: 1 }]
      - def:
          name: image_list
          access: public
          return: { type: string, lifetime: producer }
          body: [{ return: "" }]
