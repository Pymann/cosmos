# StageSecretStore — which secrets a stage binds, and binding them at claim
# (doc/spec/115 §115.4).
#
# Own KV `stage_secrets`, keyed by stage id "<run>-<lane>-<nr>", for the
# reason run_layers and stage_keys have one: a field on PipelineStage changes
# the schema fingerprint and every stored run becomes unreadable (doc/spec/108
# F108-2).  The rows hold NAMES only.  Values are read when the stage is
# handed out (`bind`), go into the assignment and nowhere else.
#
# Static-Check (aiml spec/49 §14): 1 class.
- import: "sources/models/secret_kind.aiml"
- import: "sources/models/step_secret.aiml"
- import: "sources/models/casc_basics.aiml"
- import: "sources/server/secret_kinds.aiml"

- class:
    name: StageSecretStore
    members:
      - [rows, Kv<string:StageSecretRow>]
    methods:
      - def:
          name: init
          access: public
          body:
            - set: [<.rows, { call: [db.open_kv, "stage_secrets", {persist: true}] }]

      # declare: what `stg.secrets` said at submit (aiml F62-165/166).
      - def:
          name: declare
          access: public
          args: [[stage_id, string], [binds, string]]
          body:
            - if: { condition: { eq: [binds.len, 0] }, then: [{ return: null }] }
            - decl: [row, StageSecretRow]
            - set: [row.stage_id, stage_id]
            - set: [row.binds, binds]
            - call: [<.rows.set, stage_id, row]

      - def:
          name: binds_of
          access: public
          args: [[stage_id, string]]
          return: { type: string, lifetime: producer }
          body:
            - if: { condition: { eq: [{ call: [<.rows.has, stage_id] }, 0] }, then: [{ return: "" }] }
            - decl: [row, StageSecretRow, { call: [<.rows.get_copy, stage_id] }]
            - return: row.binds

      # value_of: the secret part of `name` as the server reads it.  A file is
      # taken as it is for the file kinds (a key needs its last newline) and
      # trimmed for the others, like CascStore.secret_value (F100-10).
      - def:
          name: value_of
          access: public
          static_off: ["str_cmp"]
          args: [[secrets, list<CascSecret>], [name, string], [whole, i32]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [six, i32, 0]
            - while:
                condition: { lt: [six, secrets.len] }
                body:
                  - decl: [sec, CascSecret, { at: [secrets, six] }]
                  - set: [six, { +: [six, 1] }]
                  - if:
                      condition: { eq: [sec.name, name] }
                      then:
                        - if:
                            condition: { eq: [sec.source, "file"] }
                            then:
                              - if: { condition: { eq: [{ call: [io.is_file, sec.ref] }, false] }, then: [{ return: "" }] }
                              - decl: [raw, string, { call: [io.read_file, sec.ref] }]
                              - if: { condition: { eq: [whole, 1] }, then: [{ return: raw }] }
                              - return: { call: [raw.trim] }
                        - decl: [envm, map<string:string>, { call: [sys.env] }]
                        - if: { condition: { gt: [{ call: [envm.contains, sec.ref] }, 0] }, then: [{ return: { call: [envm.get, sec.ref] } }] }
                        - return: ""
            - return: ""

      # side_file: a non-secret file the kind names (cert, ca, known_hosts).
      - def:
          name: side_file
          access: public
          args: [[where, string], [out, ref<StepSecretSet>], [what, string]]
          return: { type: string, lifetime: producer }
          body:
            - if: { condition: { eq: [where.len, 0] }, then: [{ return: "" }] }
            - if:
                condition: { eq: [{ call: [io.is_file, where] }, false] }
                then:
                  - if: { condition: { eq: [out.error.len, 0] }, then: [{ set: [out.error, "${what}: file ${where} is missing on the server"] }] }
                  - return: ""
            - return: { call: [io.read_file, where] }

      # bind: the names of `binds` resolved, or why not (F115-12/13).  The
      # error names the secret, never a value.
      - def:
          name: bind
          access: public
          static_off: ["str_cmp"]
          args: [[binds, string], [secrets, list<CascSecret>], [kinds, ref<SecretKinds>]]
          return: { type: StepSecretSet, lifetime: producer }
          body:
            - decl: [out, StepSecretSet]
            - if: { condition: { eq: [binds.len, 0] }, then: [{ return: out }] }
            - decl: [rows, list<string>, { call: [binds.split, ","] }]
            - decl: [rix, i32, 0]
            - while:
                condition: { lt: [rix, rows.len] }
                body:
                  - decl: [one, string, { at: [rows, rix] }]
                  - set: [rix, { +: [rix, 1] }]
                  - decl: [cut, i32, { call: [one.index_of, ":"] }]
                  - if: { condition: { le: [cut, 0] }, then: [{ set: [out.error, "secret binding '${one}' is not name:ENV"] }, { return: out }] }
                  - decl: [name, string, { call: [one.substr, 0, cut] }]
                  - decl: [item, StepSecret]
                  - set: [item.env, { call: [one.substr, { +: [cut, 1] }, { -: [one.len, { +: [cut, 1] }] }] }]
                  - decl: [kind, SecretKind, { call: [kinds.kind_of, name] }]
                  - set: [item.kind, kind.kind]
                  - decl: [whole, i32, 1]
                  - if: { condition: { '||': [{ eq: [kind.kind, "token"] }, { eq: [kind.kind, "user_password"] }] }, then: [{ set: [whole, 0] }] }
                  - set: [item.value, { call: [<.value_of, secrets, name, whole] }]
                  - if:
                      condition: { eq: [item.value.len, 0] }
                      then:
                        - set: [out.error, "secret '${name}' has no value on the server — not declared under config.secrets, its file missing or its variable unset (doc/spec/115 F115-12)"]
                        - return: out
                  - if:
                      condition: { lt: [item.value.len, 4] }
                      then:
                        - set: [out.error, "secret '${name}' is shorter than 4 bytes and cannot be masked (doc/spec/115 F115-13)"]
                        - return: out
                  - set: [item.user, kind.user]
                  - if:
                      condition: { gt: [kind.passphrase.len, 0] }
                      then:
                        - set: [item.passphrase, { call: [<.value_of, secrets, kind.passphrase, 0] }]
                        - if:
                            condition: { lt: [item.passphrase.len, 4] }
                            then:
                              - set: [out.error, "secret '${name}': its passphrase '${kind.passphrase}' has no maskable value (doc/spec/115 F115-12/13)"]
                              - return: out
                  - set: [item.cert, { call: [<.side_file, kind.cert, out, "secret '${name}' cert"] }]
                  - set: [item.ca_cert, { call: [<.side_file, kind.ca_cert, out, "secret '${name}' ca"] }]
                  - set: [item.known_hosts, { call: [<.side_file, kind.known_hosts, out, "secret '${name}' known_hosts"] }]
                  - if: { condition: { gt: [out.error.len, 0] }, then: [{ return: out }] }
                  - call: [out.items.push, item]
            - return: out
