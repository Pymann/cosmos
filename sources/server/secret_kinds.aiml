# SecretKinds — what config.secrets says about a secret besides its value
# (doc/spec/115 §115.2): its kind and the non-secret fields the kind needs.
# KV `casc_secret_kinds`, beside `casc_config` and never as new fields of
# CascSecret (F115-4, doc/spec/108 F108-2).
#
# Static-Check (aiml spec/49 §14): 1 class.

- import: "sources/models/catalog_entry.aiml"
- import: "sources/models/secret_kind.aiml"

- class:
    name: SecretKinds
    members:
      - [cfg, Kv<string:SecretKindSet>]
    methods:
      - def:
          name: init
          access: public
          args: [[db_dir, path]]
          body:
            - set: [<.cfg, { call: [db.open_kv, "casc_secret_kinds", {persist: true}] }]

      - def:
          name: current
          access: public
          return: { type: SecretKindSet, lifetime: producer }
          body:
            - decl: [out, SecretKindSet]
            - if: { condition: { gt: [{ call: [<.cfg.has, "current"] }, 0] }, then: [{ set: [out, { call: [<.cfg.get_copy, "current"] }] }] }
            - return: out

      # kind_of: what is declared for `name`; a secret without an entry is a
      # `token` (F115-1).
      - def:
          name: kind_of
          access: public
          static_off: ["str_cmp"]
          args: [[name, string]]
          return: { type: SecretKind, lifetime: producer }
          body:
            - decl: [out, SecretKind]
            - set: [out.name, name]
            - set: [out.kind, "token"]
            - decl: [cur, SecretKindSet, { call: [<.current] }]
            - decl: [kix, i32, 0]
            - while:
                condition: { lt: [kix, cur.kinds.len] }
                body:
                  - decl: [one, SecretKind, { at: [cur.kinds, kix] }]
                  - set: [kix, { +: [kix, 1] }]
                  - if: { condition: { eq: [one.name, name] }, then: [{ return: one }] }
            - return: out

      # check: a passphrase names a declared secret (F115-3).
      - def:
          name: check
          access: public
          static_off: ["str_cmp"]
          args: [[want, ref<SecretKindSet>], [secrets, list<CascSecret>], [plan, ref<CascPlan>]]
          body:
            - decl: [names, list<string>]
            - decl: [six, i32, 0]
            - while:
                condition: { lt: [six, secrets.len] }
                body:
                  - decl: [sec, CascSecret, { at: [secrets, six] }]
                  - set: [six, { +: [six, 1] }]
                  - call: [names.push, sec.name]
            - decl: [kix, i32, 0]
            - while:
                condition: { lt: [kix, want.kinds.len] }
                body:
                  - decl: [one, SecretKind, { at: [want.kinds, kix] }]
                  - set: [kix, { +: [kix, 1] }]
                  - if:
                      condition: { '&&': [{ gt: [one.passphrase.len, 0] }, { eq: [{ call: [names.contains, one.passphrase] }, 0] }] }
                      then: [{ call: [plan.errors.push, "secret ${one.name}: passphrase '${one.passphrase}' is not declared under secrets:"] }]

      # text_of: the non-secret part of an entry, one line, for the plan.
      - def:
          name: text_of
          access: public
          args: [[one, SecretKind]]
          return: { type: string, lifetime: producer }
          body:
            - return: "kind=${one.kind} user=${one.user} passphrase=${one.passphrase} cert=${one.cert} ca=${one.ca_cert} known_hosts=${one.known_hosts}"

      # plan: what would change (F115-21; F100-3: touches nothing).  Values are
      # not here and cannot be.
      - def:
          name: plan
          access: public
          static_off: ["str_cmp"]
          args: [[want, ref<SecretKindSet>], [plan, ref<CascPlan>]]
          body:
            - decl: [kix, i32, 0]
            - while:
                condition: { lt: [kix, want.kinds.len] }
                body:
                  - decl: [one, SecretKind, { at: [want.kinds, kix] }]
                  - set: [kix, { +: [kix, 1] }]
                  - decl: [have, SecretKind, { call: [<.kind_of, one.name] }]
                  - decl: [now_txt, string, { call: [<.text_of, have] }]
                  - decl: [new_txt, string, { call: [<.text_of, one] }]
                  - if:
                      condition: { neq: [now_txt, new_txt] }
                      then:
                        - decl: [row, PlanChange]
                        - set: [row.domain, "config"]
                        - set: [row.action, "change"]
                        - set: [row.target, "secret.${one.name}"]
                        - set: [row.detail, "${now_txt} -> ${new_txt}"]
                        - call: [plan.changes.push, row]

      - def:
          name: apply
          access: public
          args: [[want, ref<SecretKindSet>]]
          body:
            - decl: [copy, SecretKindSet, want]
            - call: [<.cfg.set, "current", copy]
