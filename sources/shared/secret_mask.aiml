# cosmos.secrets.SecretMask — what a log must not show (doc/spec/115 §115.5).
#
# One instance per stage that binds secrets: the agent's StepWorker holds one
# for the stage it runs, the server's RunStore one per stage it logs.  No
# global: two stages on one server have two maskers.
#
# The values are kept longest first, so a value that contains another one is
# masked whole (F115-15).  Per value also its base64 (F115-18); a multi-line
# value (a key file) is masked line by line, each line of 16 bytes or more.
#
# Static-Check (aiml spec/49 §14): 1 class.
- import: "sources/models/step_secret.aiml"

- namespace: cosmos.secrets

- class:
    name: SecretMask
    members:
      - [vals,    list<string>]
      - [longest, i32, 0]
    methods:
      - def:
          name: clear
          access: public
          body:
            - decl: [none, list<string>]
            - set: [<.vals, none]
            - set: [<.longest, 0]

      - def:
          name: count
          access: public
          return: i32
          body:
            - return: <.vals.len

      # put: one literal value, sorted in by length (longest first), no
      # duplicates.  Shorter than 4 bytes is not maskable (F115-13); the
      # caller refuses such a secret before it gets here.
      - def:
          name: put
          access: public
          static_off: ["str_cmp"]
          args: [[val, string]]
          body:
            - if: { condition: { lt: [val.len, 4] }, then: [{ return: null }] }
            - if: { condition: { gt: [{ call: [<.vals.contains, val] }, 0] }, then: [{ return: null }] }
            - decl: [out, list<string>]
            - decl: [placed, i32, 0]
            - decl: [vix, i32, 0]
            - while:
                condition: { lt: [vix, <.vals.len] }
                body:
                  - decl: [one, string, { at: [<.vals, vix] }]
                  - if:
                      condition: { '&&': [{ eq: [placed, 0] }, { gt: [val.len, one.len] }] }
                      then: [{ call: [out.push, val] }, { set: [placed, 1] }]
                  - call: [out.push, one]
                  - set: [vix, { +: [vix, 1] }]
            - if: { condition: { eq: [placed, 0] }, then: [{ call: [out.push, val] }] }
            - set: [<.vals, out]
            - if: { condition: { gt: [val.len, <.longest] }, then: [{ set: [<.longest, val.len] }] }

      # add: a secret value as a step could print it (F115-18).
      - def:
          name: add
          access: public
          static_off: ["str_cmp"]
          args: [[val, string]]
          body:
            - if: { condition: { lt: [{ call: [val.index_of, "\n"] }, 0] }, then: [{ call: [<.put, val] }, { call: [<.put, { call: [base64.encode, val] }] }, { return: null }] }
            - decl: [lines, list<string>, { call: [val.split, "\n"] }]
            - decl: [lix, i32, 0]
            - while:
                condition: { lt: [lix, lines.len] }
                body:
                  - decl: [raw, string, { at: [lines, lix] }]
                  - decl: [line, string, { call: [raw.trim] }]
                  - set: [lix, { +: [lix, 1] }]
                  - if:
                      condition: { '&&': [{ ge: [line.len, 16] }, { eq: [{ call: [line.starts_with, "-----"] }, 0] }] }
                      then: [{ call: [<.put, line] }]

      # add_pair: the HTTP Basic form of a username/password (F115-18).
      - def:
          name: add_pair
          access: public
          args: [[user, string], [pass, string]]
          body:
            - call: [<.put, { call: [base64.encode, "${user}:${pass}"] }]

      # add_bound: everything of one bound secret a log must not show.
      - def:
          name: add_bound
          access: public
          static_off: ["str_cmp"]
          args: [[item, StepSecret]]
          body:
            - call: [<.add, item.value]
            - if: { condition: { eq: [item.kind, "user_password"] }, then: [{ call: [<.add_pair, item.user, item.value] }] }
            - if: { condition: { gt: [item.passphrase.len, 0] }, then: [{ call: [<.add, item.passphrase] }] }

      - def:
          name: add_all
          access: public
          args: [[items, list<StepSecret>]]
          body:
            - decl: [iix, i32, 0]
            - while:
                condition: { lt: [iix, items.len] }
                body:
                  - call: [<.add_bound, { at: [items, iix] }]
                  - set: [iix, { +: [iix, 1] }]

      # apply: every value replaced by ****, longest first.
      - def:
          name: apply
          access: public
          args: [[text, string]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [out, string, text]
            - decl: [vix, i32, 0]
            - while:
                condition: { lt: [vix, <.vals.len] }
                body:
                  - set: [out, { call: [out.replace, { at: [<.vals, vix] }, "****"] }]
                  - set: [vix, { +: [vix, 1] }]
            - return: out

      # safe_cut: how much of `text` may be sent now (F115-16).  All but the
      # last `longest - 1` bytes, and never through the middle of a value: a
      # value that crosses the cut moves it back to the value's start.  At the
      # end of the stream (`final`) everything goes.
      - def:
          name: safe_cut
          access: public
          args: [[text, string], [final, i32]]
          return: i32
          body:
            - if: { condition: { '||': [{ eq: [final, 1] }, { eq: [<.vals.len, 0] }] }, then: [{ return: text.len }] }
            - decl: [cut, i32, { -: [text.len, { -: [<.longest, 1] }] }]
            - if: { condition: { le: [cut, 0] }, then: [{ return: 0 }] }
            - decl: [vix, i32, 0]
            - while:
                condition: { lt: [vix, <.vals.len] }
                body:
                  - decl: [one, string, { at: [<.vals, vix] }]
                  - set: [vix, { +: [vix, 1] }]
                  - decl: [from, i32, { -: [cut, { -: [one.len, 1] }] }]
                  - if: { condition: { lt: [from, 0] }, then: [{ set: [from, 0] }] }
                  - decl: [span, i32, { +: [{ -: [cut, from] }, { -: [one.len, 1] }] }]
                  - if: { condition: { gt: [{ +: [from, span] }, text.len] }, then: [{ set: [span, { -: [text.len, from] }] }] }
                  - decl: [win, string, { call: [text.substr, from, span] }]
                  - decl: [base, i32, from]
                  - decl: [hunt, i32, 1]
                  - while:
                      condition: { eq: [hunt, 1] }
                      body:
                        - decl: [hit, i32, { call: [win.index_of, one] }]
                        - if:
                            condition: { lt: [hit, 0] }
                            then: [{ set: [hunt, 0] }]
                            else:
                              - decl: [at_pos, i32, { +: [base, hit] }]
                              - if:
                                  condition: { '&&': [{ lt: [at_pos, cut] }, { gt: [{ +: [at_pos, one.len] }, cut] }] }
                                  then: [{ set: [cut, at_pos] }, { set: [hunt, 0] }]
                                  else:
                                    - set: [base, { +: [at_pos, 1] }]
                                    - set: [win, { call: [win.substr, { +: [hit, 1] }, { -: [win.len, { +: [hit, 1] }] }] }]
            - return: cut

      # to_text / from_text: the masks as base64, one per line — the file the
      # agent reads back after a restart (F115-20).  The file holds what the
      # masker holds and nothing more.
      - def:
          name: to_text
          access: public
          return: { type: string, lifetime: producer }
          body:
            - decl: [out, string, ""]
            - decl: [vix, i32, 0]
            - while:
                condition: { lt: [vix, <.vals.len] }
                body:
                  - set: [out, "${out}${{ call: [base64.encode, { at: [<.vals, vix] }] }}\n"]
                  - set: [vix, { +: [vix, 1] }]
            - return: out

      - def:
          name: from_text
          access: public
          args: [[text, string]]
          body:
            - call: [<.clear]
            - decl: [lines, list<string>, { call: [text.split, "\n"] }]
            - decl: [lix, i32, 0]
            - while:
                condition: { lt: [lix, lines.len] }
                body:
                  - decl: [raw, string, { at: [lines, lix] }]
                  - decl: [line, string, { call: [raw.trim] }]
                  - set: [lix, { +: [lix, 1] }]
                  - if: { condition: { gt: [line.len, 0] }, then: [{ call: [<.put, { call: [base64.decode_str, line] }] }] }
