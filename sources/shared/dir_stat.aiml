# Wie GROSS ist ein Verzeichnisbaum?  Zwei Zahlen: Bytes und Dateien.
#
# Gebraucht fuer die Schicht einer Stufe (doc/spec/107 §107.1c, doc/spec/110
# F110-93): die Platte im Bild sagt die Groessenordnung, und die muss jemand
# messen.  `du` waere ein zweiter Prozess je Schritt, nur um zwei Zahlen zu
# holen — und ein Prozess, der im Container anders zaehlt als draussen.
#
# Gezaehlt wird die LOGISCHE Groesse (Summe der Dateilaengen), nicht der
# belegte Plattenplatz: letzterer haengt an der Blockgroesse des Wirts, und
# dieselbe Schicht waere auf zwei Rechnern verschieden gross.  Symlinks zaehlen
# als Datei, aber nicht als Bytes — ihr Ziel liegt woanders.
#
# Static-Check (aiml spec/49 §14): 1 model, 1 class.

- model:
    name: DirStat
    fields:
      - [bytes, i64]
      - [files, i32]
      # Wie tief der Baum war, bis die Grenze griff.  Ungleich 0 heisst: die
      # Zahlen sind eine UNTERgrenze, nicht die Wahrheit.
      - [cut,   i32]

- class:
    name: DirScan
    members:
      - [depth_max, i32]
    methods:
      - def:
          name: init
          access: public
          args: [[depth_max, i32]]
          body:
            - set: [<.depth_max, 64]
            - if: { condition: { gt: [depth_max, 0] }, then: [{ set: [<.depth_max, depth_max] }] }

      # of_dir: der Baum unter `dir`, rekursiv.  Ein Verzeichnis, das es nicht
      # gibt, ist nicht ein Fehler, sondern leer — eine Stufe ohne Schicht hat
      # eben keine.
      - def:
          name: of_dir
          access: public
          static_off: ["str_cmp"]
          args: [[dir, string], [depth, i32]]
          return: DirStat
          body:
            - decl: [out, DirStat]
            - decl: [dir_p, path, dir]
            - if: { condition: { eq: [{ call: [io.is_dir, dir_p] }, false] }, then: [{ return: out }] }
            - if:
                condition: { ge: [depth, <.depth_max] }
                then: [{ set: [out.cut, 1] }, { return: out }]
            - decl: [kids, list<path>, { call: [io.list_dir, dir_p] }]
            - decl: [kix, i32, 0]
            - while:
                condition: { lt: [kix, kids.len] }
                body:
                  - decl: [kid, path, { at: [kids, kix] }]
                  - decl: [full, string, { call: [kid.to_string] }]
                  - set: [kix, { +: [kix, 1] }]
                  # Reihenfolge wie in cas_trees.put_tree: der Link ZUERST,
                  # sonst folgt is_dir ihm und wir zaehlen fremde Baeume mit.
                  - if:
                      condition: { gt: [{ call: [io.is_symlink, full] }, 0] }
                      then:
                        - set: [out.files, { +: [out.files, 1] }]
                      else:
                        - if:
                            condition: { eq: [{ call: [io.is_dir, full] }, true] }
                            then:
                              - decl: [sub, DirStat, { call: [<.of_dir, full, { +: [depth, 1] }] }]
                              - set: [out.bytes, { +: [out.bytes, sub.bytes] }]
                              - set: [out.files, { +: [out.files, sub.files] }]
                              - if: { condition: { neq: [sub.cut, 0] }, then: [{ set: [out.cut, 1] }] }
                            else:
                              - set: [out.files, { +: [out.files, 1] }]
                              - set: [out.bytes, { +: [out.bytes, { call: [io.file_size, full] }] }]
            - return: out
