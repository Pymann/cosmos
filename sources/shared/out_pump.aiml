# Ausgabe nachziehen: EINE Stelle fuer das, was dabei schiefgeht.
#
# Sowohl der AP1-Einzelbefehl (doc/spec/90) als auch der Pipeline-Schritt
# (doc/spec/103 §103.4e) muessen dieselbe Arbeit tun: aus einer Datei ab einem
# Offset lesen und als Chunk schicken.  Zwei Kopien hiessen zwei Orte, an denen
# die folgenden zwei Lehren verloren gehen koennen.
#
#   1. DECKEL je Chunk (64 KiB).  Ein unbegrenzter Schwall (gemessen: 6,9 MB in
#      einem Rutsch) fuehrte reproduzierbar dazu, dass der Server die noch
#      lebende Agenten-Verbindung als getrennt meldete und die restliche
#      Ausgabe verwarf — die Mirror-Queue ist pro Sender begrenzt (4096 Events /
#      64 MiB, spec/44_5), und der relayende Konsument ist langsamer als der
#      Produzent.
#   2. `sess.update()` NACH jedem Send.  Ein Schwall von Sends ohne update()
#      laesst die Verbindung serverseitig als getrennt gelten (2026-10-09).

- import: "sources/models/agent_proto.aiml"   # OutStream
- import: "sources/models/run_output.aiml"
- import: "sources/shared/secret_mask.aiml"

- class:
    name: OutPump
    # doc/spec/115 §115.5: a pump with masks masks every chunk before it leaves
    # the host and never cuts through a value (F115-16).  Without masks it is
    # the pump it always was.
    members:
      - [mask,      cosmos.secrets.SecretMask]
      - [final,     i32, 0]
      - [muted,     i32, 0]
      - [said_mute, i32, 0]
    methods:
      - def:
          name: arm
          access: public
          args: [[masks_text, string]]
          body:
            - call: [<.mask.from_text, masks_text]
            - set: [<.final, 0]
            - set: [<.muted, 0]
            - set: [<.said_mute, 0]

      - def:
          name: disarm
          access: public
          body:
            - call: [<.mask.clear]
            - set: [<.final, 0]
            - set: [<.muted, 0]
            - set: [<.said_mute, 0]

      # mute: the masks are lost (F115-20) — the rest of the output stays on
      # the agent.
      - def:
          name: mute
          access: public
          body:
            - set: [<.muted, 1]

      - def:
          name: set_final
          access: public
          args: [[ended, i32]]
          body:
            - set: [<.final, ended]

      - def:
          name: masked
          access: public
          args: [[text, string]]
          return: { type: string, lifetime: producer }
          body:
            - if: { condition: { eq: [{ call: [<.mask.count] }, 0] }, then: [{ return: text }] }
            - return: { call: [<.mask.apply, text] }

      # tail: nur die neuen Bytes ab `off` lesen und als Chunk senden.
      # Rueckgabe: der neue Offset (unveraendert, wenn es nichts Neues gab).
      - def:
          name: tail
          access: public
          args: [[sess, mirror_session], [run_ref, string], [stream, i32], [spath, string], [off, i64]]
          return: i64
          body:
            - decl: [total, i64, { call: [io.file_size, spath] }]
            - if: { condition: { le: [total, off] }, then: [{ return: off }] }
            - decl: [want, i64, { -: [total, off] }]
            - if: { condition: { gt: [want, 65536] }, then: [{ set: [want, 65536] }] }
            - decl: [src, file_handle, { call: [io.open, spath, "r"] }]
            - if: { condition: { eq: [src, null] }, then: [{ return: off }] }
            - call: [io.seek, src, off]
            - decl: [text, string, { call: [io.read, src, want] }]
            - call: [io.close, src]
            - if: { condition: { eq: [text.len, 0] }, then: [{ return: off }] }
            - if:
                condition: { eq: [<.muted, 1] }
                then:
                  - if:
                      condition: { eq: [<.said_mute, 0] }
                      then:
                        - set: [<.said_mute, 1]
                        - call: [<.send_text, sess, run_ref, stream, "\n… output withheld: the agent restarted and lost the masks of this stage's secrets (doc/spec/115 F115-20) — full output on the agent …\n", off]
                  - return: { +: [off, text.len] }
            - if:
                condition: { gt: [{ call: [<.mask.count] }, 0] }
                then:
                  - decl: [cut, i32, { call: [<.mask.safe_cut, text, <.final] }]
                  - if: { condition: { le: [cut, 0] }, then: [{ return: off }] }
                  - decl: [part, string, { call: [text.substr, 0, cut] }]
                  - call: [<.send_text, sess, run_ref, stream, { call: [<.mask.apply, part] }, off]
                  - return: { +: [off, cut] }
            - call: [<.send_text, sess, run_ref, stream, text, off]
            - return: { +: [off, text.len] }

      # send_text: einen fertigen Text als Chunk schicken (auch fuer Hinweise
      # wie „Ausgabe abgeschnitten", die nicht aus einer Datei kommen).
      - def:
          name: send_text
          access: public
          args: [[sess, mirror_session], [run_ref, string], [stream, i32], [text, string], [off, i64]]
          body:
            - decl: [msg, OutChunk]
            - set: [msg.run_ref, run_ref]
            - set: [msg.stream, stream]
            - set: [msg.chunk, text]
            - set: [msg.offset, off]
            - call: [sess.send_rpc, 0, "command_output", 0, msg]
            # Siehe Lehre 2 im Dateikopf.
            - call: [sess.update]
