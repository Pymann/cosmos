# StepSecretFiles — where the agent puts a stage's secrets (doc/spec/115 §115.4).
#
#   <step>.secrets/          0700, BESIDE the step directory (F115-11)
#     env                    0400  `export NAME='…'` lines, sourced before the command
#     <ENV>, <ENV>_KEY, …    0400  the files of the file kinds
#     masks                  0400  the masker's values, base64 (F115-20)
#
# Never an argument list (F115-10): the command names only the env file.  The
# directory is the first thing laid out and the last thing removed.
#
# Static-Check (aiml spec/49 §14): 1 class.
- import: "sources/models/step_secret.aiml"
- import: "sources/shared/secret_mask.aiml"

- class:
    name: StepSecretFiles
    methods:
      - def:
          name: dir_of
          access: public
          args: [[step_dir, string]]
          return: { type: string, lifetime: producer }
          body:
            - return: "${step_dir}.secrets"

      # quoted: a value as one shell word in single quotes ('  →  '\'').
      - def:
          name: quoted
          access: public
          args: [[val, string]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [inner, string, { call: [val.replace, "'", "'\\''"] }]
            - return: "'${inner}'"

      # put_file: one 0400 file; its path.
      - def:
          name: put_file
          access: public
          args: [[dir, string], [name, string], [content, string]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [where, string, "${dir}/${name}"]
            - call: [io.write_file, where, content]
            - call: [fsmeta.chmod, where, 256]
            - return: where

      # line: one `export` line.
      - def:
          name: line
          access: public
          args: [[name, string], [val, string]]
          return: { type: string, lifetime: producer }
          body:
            - return: "export ${name}=${{ call: [<.quoted, val] }}\n"

      # file_line: one variable that holds the path of a new 0400 file.
      - def:
          name: file_line
          access: public
          args: [[dir, string], [name, string], [content, string]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [where, string, { call: [<.put_file, dir, name, content] }]
            - return: { call: [<.line, name, where] }

      # lines_of: the variables of one secret, per kind (doc/spec/115 §115.4).
      - def:
          name: lines_of
          access: public
          static_off: ["str_cmp"]
          args: [[dir, string], [item, StepSecret]]
          return: { type: string, lifetime: producer }
          body:
            - decl: [out, string, ""]
            - decl: [env, string, item.env]
            - decl: [more, string, ""]
            - if: { condition: { eq: [item.kind, "token"] }, then: [{ return: { call: [<.line, env, item.value] } }] }
            - if:
                condition: { eq: [item.kind, "user_password"] }
                then:
                  - set: [out, { call: [<.line, "${env}_USER", item.user] }]
                  - set: [more, { call: [<.line, "${env}_PASSWORD", item.value] }]
                  - return: "${out}${more}"
            - if: { condition: { eq: [item.kind, "file"] }, then: [{ return: { call: [<.file_line, dir, env, item.value] } }] }
            - if:
                condition: { eq: [item.kind, "ssh_key"] }
                then:
                  - set: [out, { call: [<.file_line, dir, env, item.value] }]
                  - if:
                      condition: { gt: [item.user.len, 0] }
                      then:
                        - set: [more, { call: [<.line, "${env}_USER", item.user] }]
                        - set: [out, "${out}${more}"]
                  - if:
                      condition: { gt: [item.passphrase.len, 0] }
                      then:
                        - set: [more, { call: [<.line, "${env}_PASSPHRASE", item.passphrase] }]
                        - set: [out, "${out}${more}"]
                  - if:
                      condition: { gt: [item.known_hosts.len, 0] }
                      then:
                        - set: [more, { call: [<.file_line, dir, "${env}_KNOWN_HOSTS", item.known_hosts] }]
                        - set: [out, "${out}${more}"]
                  - return: out
            - if:
                condition: { eq: [item.kind, "tls_client"] }
                then:
                  - set: [out, { call: [<.file_line, dir, "${env}_KEY", item.value] }]
                  - set: [more, { call: [<.file_line, dir, "${env}_CERT", item.cert] }]
                  - set: [out, "${out}${more}"]
                  - if:
                      condition: { gt: [item.ca_cert.len, 0] }
                      then:
                        - set: [more, { call: [<.file_line, dir, "${env}_CA", item.ca_cert] }]
                        - set: [out, "${out}${more}"]
                  - return: out
            - return: ""

      # lay_out: the directory for `items`, the masker filled.  Returns the
      # env file's path, "" when there are no secrets.
      - def:
          name: lay_out
          access: public
          args: [[step_dir, string], [items, list<StepSecret>], [mask, ref<cosmos.secrets.SecretMask>]]
          return: { type: string, lifetime: producer }
          body:
            - call: [<.remove, step_dir]
            - if: { condition: { eq: [items.len, 0] }, then: [{ return: "" }] }
            - decl: [dir, string, { call: [<.dir_of, step_dir] }]
            - decl: [dir_p, path, dir]
            - call: [io.mkdir_all, dir_p]
            - call: [fsmeta.chmod, dir, 448]
            - decl: [text, string, ""]
            - decl: [iix, i32, 0]
            - while:
                condition: { lt: [iix, items.len] }
                body:
                  - decl: [item, StepSecret, { at: [items, iix] }]
                  - set: [iix, { +: [iix, 1] }]
                  - decl: [part, string, { call: [<.lines_of, dir, item] }]
                  - set: [text, "${text}${part}"]
            - call: [mask.add_all, items]
            - call: [<.put_file, dir, "masks", { call: [mask.to_text] }]
            - return: { call: [<.put_file, dir, "env", text] }

      # restore: the masks after an agent restart (F115-20).  1 = read,
      # 0 = the stage has no secrets, -1 = it had some and the masks are gone.
      - def:
          name: restore
          access: public
          args: [[step_dir, string], [mask, ref<cosmos.secrets.SecretMask>]]
          return: i32
          body:
            - decl: [dir, string, { call: [<.dir_of, step_dir] }]
            - decl: [dir_p, path, dir]
            - if: { condition: { eq: [{ call: [io.is_dir, dir_p] }, false] }, then: [{ return: 0 }] }
            - decl: [mfile, path, "${dir}/masks"]
            - if: { condition: { eq: [{ call: [io.is_file, mfile] }, false] }, then: [{ return: -1 }] }
            - call: [mask.from_text, { call: [io.read_file, mfile] }]
            - return: 1

      - def:
          name: remove
          access: public
          args: [[step_dir, string]]
          body:
            - decl: [dir_p, path, { call: [<.dir_of, step_dir] }]
            - if: { condition: { eq: [{ call: [io.is_dir, dir_p] }, true] }, then: [{ call: [io.remove_all, dir_p] }] }
