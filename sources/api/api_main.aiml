# cosmos-api — REST-Gateway vor cosmosd (doc/spec/111 §111.8).
#
#   cosmos-api                      (Umgebung: COSMOS_API_PORT=8090,
#                                    COSMOS_API_UPSTREAM=ws://127.0.0.1:9100)
#
# Routen (alle JSON; Token per `Authorization: Bearer <token>`):
#   GET    /api/v1/health
#   POST   /api/v1/login
#   POST   /api/v1/register
#   POST   /api/v1/logout
#   GET    /api/v1/whoami
#   GET    /api/v1/cluster
#   GET    /api/v1/jobs
#   PUT    /api/v1/jobs/:id
#   POST   /api/v1/jobs/:id/run
#   GET    /api/v1/runs
#   POST   /api/v1/pipelines/run
#   POST   /api/v1/runs/:id/pause
#   POST   /api/v1/runs/:id/resume
#   POST   /api/v1/runs/:id/step
#   POST   /api/v1/runs/:id/rewind
#   POST   /api/v1/console
#   GET    /api/v1/config
#   POST   /api/v1/config/plan
#   POST   /api/v1/config/apply
#   POST   /api/v1/tokens
#   GET    /api/v1/tokens
#   DELETE /api/v1/tokens/:id
#   GET    /api/v1/campaigns
#   POST   /api/v1/hooks/museum
#   GET    /api/v1/sso/saml/login?relay=/pfad   (302 zum IdP)
#   POST   /api/v1/sso/saml/acs                 (SAML POST-Bindung)
#
# srv.route braucht freie Funktionen: jede Route verpackt die Anfrage in einen
# ApiExchange und leiht ihn dem ApiGateway.

- import: "sources/api/api_gateway.aiml"

- decl: [g_api, ptr<ApiGateway>]

- def:
    name: wrap
    args: [[req, http_request_handle], [resp, http_response_handle]]
    return: ptr<ApiExchange>
    body:
      - decl: [xch, ptr<ApiExchange>, { new: ApiExchange }]
      - set: [xch.req, req]
      - set: [xch.resp, resp]
      - return: [xch]

- def:
    name: on_health
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [xch, ptr<ApiExchange>, { call: [wrap, req, resp] }]
      - call: [g_api.serial.acquire]
      - call: [g_api.health, xch]
      - call: [g_api.serial.release]

- def:
    name: on_login
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [xch, ptr<ApiExchange>, { call: [wrap, req, resp] }]
      - call: [g_api.serial.acquire]
      - call: [g_api.login, xch]
      - call: [g_api.serial.release]

- def:
    name: on_register
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [xch, ptr<ApiExchange>, { call: [wrap, req, resp] }]
      - call: [g_api.serial.acquire]
      - call: [g_api.register, xch]
      - call: [g_api.serial.release]

- def:
    name: on_logout
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [xch, ptr<ApiExchange>, { call: [wrap, req, resp] }]
      - call: [g_api.serial.acquire]
      - call: [g_api.logout, xch]
      - call: [g_api.serial.release]

