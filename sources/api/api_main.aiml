    body:
      - decl: [xch, ptr<ApiExchange>, { call: [wrap, req, resp] }]
      - call: [g_api.serial.acquire]
      - call: [g_api.save_job, xch]
      - call: [g_api.serial.release]

- def:
    name: on_job_run
    args: [[req, http_request_handle], [resp, http_response_handle]]
    body:
      - decl: [xch, ptr<ApiExchange>, { call: [wrap, req, resp] }]
