# cosmos-oci — between a run's layers and an OCI image (doc/spec/110 §110.25).
#
#   cosmos-oci --layers <run>/layers --image <layout> [--ref-name <n>] [--arch amd64]
#   cosmos-oci --cut <dir> --image <layout> [--ref-name <n>]
#   cosmos-oci --image <layout> --bundle <dir> [--arch amd64]
#
# The work is ufo's layer kit (`@ufo/lib/kit`, ufo doc/kit.md), imported as an aiml
# package — cosmos has no OCI code of its own.  This program is the composition
# root: it builds ONE kit and hands it on as `ptr<ufo.kit.LayerKit>`; everything
# after that names only the contract.  It stays a program of its own so cosmosd
# does not block while a layer of many GB is packed.

- import: "@ufo/lib/kit/api.aiml"
- import: "@ufo/lib/kit/layout.aiml"
- import: "sources/runtime/oci_bundle.aiml"

- model:
    name: OciArgs
    fields:
      - [cut,      string, ""]
      - [layers,   string, ""]     # layers per stage (doc/spec/110 F110-95)
      - [image,    string, ""]
      - [bundle,   string, ""]
      - [work,     string, "logs/oci_work"]
      - [ref_name, string, "latest"]
      - [arch,     string, "amd64"]
      - [quiet,    i32, 0]

- def:
    name: run_with
    static_off: ["str_cmp"]
    args: [[kit, ref<ufo.kit.LayerKit>], [args, OciArgs]]
    return: i32
    body:
      - if:
          condition: { gt: [args.layers.len, 0] }
          then: [{ return: { call: [kit.images.export_layers, args.layers, args.image, args.ref_name, args.arch] } }]
      - if:
          condition: { gt: [args.cut.len, 0] }
          then:
            - if:
                condition: { eq: [{ call: [io.is_dir, args.cut] }, false] }
                then: [{ call: [log.error, "cosmos-oci: ${args.cut} ist kein Verzeichnis"] }, { return: 3 }]
            # An EMPTY cut is no image (measured 21.10.2026: a mistyped call —
            # `--cut` instead of `--bundle` — replaced a layout's index.json).
            - decl: [probe, list<path>, { call: [io.list_dir, args.cut] }]
            - if:
                condition: { eq: [probe.len, 0] }
                then:
                  - call: [log.error, "cosmos-oci: ${args.cut} ist LEER — daraus wird kein Abbild"]
                  - call: [log.error, "  Wolltest du HEREIN? Dann `--image ${args.image} --bundle ${args.cut}`."]
                  - return: 1
            - return: { call: [kit.images.export_dir, args.cut, args.image, args.ref_name, args.arch] }
      - if:
          condition: { gt: [args.bundle.len, 0] }
          then:
            - decl: [bundler, ptr<OciBundle>, { new: OciBundle }]
            - decl: [code, i32, { call: [bundler.import_image, kit, args.image, args.bundle, args.arch] }]
            - if:
                condition: { '&&': [{ eq: [code, 0] }, { eq: [args.quiet, 0] }] }
                then: [{ call: [log.info, "[oci] ${args.image} → ${args.bundle}/rootfs"] }]
            - return: code
      - call: [log.error, "cosmos-oci: weder --cut/--layers noch --bundle genannt — welche Richtung?"]
      - return: 2

- def:
    name: main
    return: i32
    body:
      - decl: [args, OciArgs]
      - call: [sys.arg_dump, args]
      - if:
          condition: { eq: [args.image.len, 0] }
          then:
            - call: [log.error, "cosmos-oci: --image <verzeichnis> fehlt"]
            - call: [log.error, "  hinaus: --cut <dir> --image <ziel>"]
            - call: [log.error, "  hinaus (geschichtet): --layers <lauf>/layers --image <ziel>"]
            - call: [log.error, "  herein: --image <image> --bundle <ziel>"]
            - return: 2
      - call: [io.mkdir_all, args.work]
      # No registry is involved here, so the layout kit; its root is never used.
      - decl: [kit, ptr<ufo.kit.LayerKit>, { new: ufo.kit.LayoutKit, root: "${args.work}/registry", git_dir: "", work_dir: args.work }]
      - return: { call: [run_with, kit, args] }
