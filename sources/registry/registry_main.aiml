# cosmos-kontor — OCI-Layouts zu kontor bringen und von dort holen
# (kontor doc/ecosystem.md §2/§3).
#
#   cosmos-kontor --mode push --layout <dir> --url <kontor> --ref <repo>:<tag>
#                 [--token-file <datei> | --token-env <VAR>] [--artifact-type <typ>]
#   cosmos-kontor --mode pull --layout <dir> --url <kontor> --ref <repo>:<tag>|<repo>@sha256:<hex>
#                 [--token-file <datei>]
#
# Das Token kommt aus einer DATEI (oder COSMOS_KONTOR_TOKEN), nie von der
# Kommandozeile: die waere fuer jeden Nutzer des Rechners in `ps` lesbar.
# Ausgabe auf stdout: die Manifest-Digest (eine Zeile) — sonst nichts.

# The client is ufo's layer kit (`ufo.kit.KontorKit`, ufo doc/kit.md §3), imported
# as an aiml package.  This program builds it once and then names only the
# contract `ufo.kit.LayerKit`.

- import: "@ufo/lib/kit/api.aiml"
- import: "@ufo/lib/kit/kontor.aiml"

- model:
    name: RegArgs
    fields:
      - [mode,          string, ""]
      - [layout,        string, ""]
      - [url,           string, ""]
      - [ref,           string, ""]
      - [token_file,    string, ""]
      - [token_env,     string, ""]
      - [artifact_type, string, ""]

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [args, RegArgs]
      - call: [sys.arg_dump, args]
      - if:
          condition: { '||': [{ eq: [args.layout.len, 0] }, { '||': [{ eq: [args.url.len, 0] }, { eq: [args.ref.len, 0] }] }] }
          then:
            - call: [log.error, "cosmos-kontor: --mode push|pull --layout <dir> --url <kontor> --ref <repo>:<tag> [--token-file f]"]
            - return: 2
      - decl: [token, string, ""]
      - if:
          condition: { gt: [args.token_file.len, 0] }
          then:
            - decl: [raw, string, { call: [io.read_file, args.token_file] }]
            - set: [token, { call: [raw.trim] }]
          else:
            - decl: [envm, map<string:string>, { call: [sys.env] }]
            - decl: [env_name, string, "COSMOS_KONTOR_TOKEN"]
            - if: { condition: { gt: [args.token_env.len, 0] }, then: [{ set: [env_name, args.token_env] }] }
            - if: { condition: { gt: [{ call: [envm.contains, env_name] }, 0] }, then: [{ set: [token, { call: [envm.get, env_name] }] }] }
      # <repo>@sha256:<hex> or <repo>:<tag>; a bare <repo> means :latest.  The tag
      # is after the LAST ':' behind the last '/', so "host:5000/a" has none.
      - decl: [reference, string, args.ref]
      - decl: [segs, list<string>, { call: [args.ref.split, "/"] }]
      - decl: [tail, string, { call: [segs.get, { -: [segs.len, 1] }] }]
      - if:
          condition: { '&&': [{ lt: [{ call: [args.ref.index_of, "@"] }, 0] }, { lt: [{ call: [tail.index_of, ":"] }, 0] }] }
          then: [{ set: [reference, "${args.ref}:latest"] }]
      - decl: [work, string, "logs/kontor_work"]
      - call: [io.mkdir_all, work]
      - decl: [kit, ptr<ufo.kit.LayerKit>, { new: ufo.kit.KontorKit, url: args.url, token: token, git_dir: "", work_dir: work }]
      - return: { call: [transfer, kit, args, reference] }

# transfer: push or pull through the contract only.  Prints the manifest digest.
- def:
    name: transfer
    static_off: ["str_cmp"]
    args: [[kit, ref<ufo.kit.LayerKit>], [args, RegArgs], [reference, string]]
    return: i32
    body:
      - if:
          condition: { eq: [args.mode, "push"] }
          then:
            - decl: [pushed, string, { call: [kit.registry.push, args.layout, reference, args.artifact_type] }]
            - if: { condition: { eq: [pushed.len, 0] }, then: [{ return: 1 }] }
            - print: ["${pushed}"]
            - return: 0
      - if:
          condition: { eq: [args.mode, "pull"] }
          then:
            - decl: [pulled, string, { call: [kit.registry.pull, reference, args.layout] }]
            - if: { condition: { eq: [pulled.len, 0] }, then: [{ return: 1 }] }
            - print: ["${pulled}"]
            - return: 0
      - call: [log.error, "cosmos-kontor: --mode muss push oder pull sein"]
      - return: 2
