# Ein kontor-Webhook, vom REST-Gateway an cosmosd weitergereicht (doc/spec/111
# §111.6, kontor doc/ecosystem.md §4).
#
# Das Gateway prueft die Signatur NICHT selbst: das Geheimnis kennt nur
# cosmosd (erklaerte Konfiguration, F100-10).  Es reicht die rohen Bytes und
# den Header durch; cosmosd rechnet die HMAC ueber genau diese Bytes nach.
#
# Static-Check (aiml spec/49 §14): 3 models.

- import: "sources/models/campaign.aiml"

- model:
    name: KontorEventReq
    fields:
      - [event,     string]   # X-Kontor-Event
      - [delivery,  string]   # X-Kontor-Delivery
      - [signature, string]   # X-Kontor-Signature-256 ("sha256=<hex>")
      - [body,      string]   # roher JSON-Koerper

- model:
    name: KontorEventResp
    fields:
      - [success, i32]
      - [message, string]
      # Was daraus wurde: "ignored", "duplicate", "campaign <id>", …
      - [outcome, string]

# Das gelesene `package.published` (kontor doc/ecosystem.md §4) — nur was die
# Kampagnen brauchen.  `items` sind die Posten aus `rebuild_waves` + `needs`.
- model:
    name: PublishedEvent
    fields:
      - [name,       string]
      - [version,    string]
      - [unchanged,  i32]
      - [has_impact, i32]
      - [items,      list<CampaignItem>]
