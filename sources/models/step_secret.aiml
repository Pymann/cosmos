# Secrets for steps, the wire side (doc/spec/115 §115.4).
#
#   StepSecret      one bound secret as the agent gets it: WITH its value, in
#                   memory and on the wire only, never stored
#   StepSecretSet   what a claim hands out, or why it cannot
#
# Static-Check (aiml spec/49 §14): 2 models.

- model:
    name: StepSecret
    fields:
      - [env,         string]
      - [kind,        string]
      - [value,       string]   # the secret part
      - [user,        string]
      - [passphrase,  string]   # the passphrase VALUE (ssh_key)
      - [cert,        string]   # contents, not paths
      - [ca_cert,     string]
      - [known_hosts, string]

- model:
    name: StepSecretSet
    fields:
      - [error,   string]       # "" = all bound; else the stage fails with 125 (F115-12)
      - [items,   list<StepSecret>]
