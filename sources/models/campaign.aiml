# Rebuild-Kampagnen (doc/spec/111 §111.6, kontor doc/ecosystem.md §5).
#
# kontor rechnet aus, WAS von einer neuen Paketversion abhaengt (Wellen +
# `needs`); cosmos entscheidet, WANN es laeuft.  Eine Kampagne ist ein
# Ausloeser (name@version) und je betroffenem Projekt ein Posten.
#
# Zustaende eines Postens:
#   waiting    wartet auf seine Abhaengigkeiten (needs)
#   running    Lauf gestartet (run_id)
#   built      Lauf fertig, kontor hat (noch) nichts veroeffentlicht → gilt als geaendert
#   published  kontor meldet eine neue Version
#   unchanged  kontor meldet byte-gleiche Ausgabe (unchanged: true)
#   skipped    nicht gebaut: alle needs blieben byte-gleich (§5 Punkt 5)
#   no_job     kein Katalog-Job fuer das Projekt — wartet auf fremde Veroeffentlichung
#   failed     Lauf gescheitert oder nicht startbar
#   blocked    eine Abhaengigkeit scheiterte (fail closed, §5 Punkt 4)
#
# Static-Check (aiml spec/49 §14): 3 models.

- model:
    name: CampaignItem
    fields:
      - [project, string]
      - [wave,    i32]
      - [needs,   list<string>]
      - [job_id,  string]
      - [state,   string]
      - [run_id,  string]
      - [note,    string]

- model:
    name: Campaign
    fields:
      - [campaign_id, string]
      - [trigger,     string]   # Projekt, dessen Veroeffentlichung sie oeffnete
      - [version,     string]
      - [delivery,    string]   # X-Kontor-Delivery des oeffnenden Ereignisses
      - [status,      string]   # running | done | failed
      - [created_ms,  i64]
      - [updated_ms,  i64]
      - [items,       list<CampaignItem>]

- model:
    name: CampaignList
    fields:
      - [success,   i32]
      - [message,   string]
      - [campaigns, list<Campaign>]
