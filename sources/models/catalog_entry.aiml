# Ein Eintrag des Pipeline-Katalogs (doc/spec/111 §111.4, nach doc/spec/100
# §100.5): was ein Job IST, wenn er aus dem Katalog kommt.
#
# Neben `JobDef`, nicht darin: ein neues Feld an JobDef machte jeden
# gespeicherten Job unlesbar (doc/spec/108 F108-2).
#
# Static-Check (aiml spec/49 §14): 2 models.
- import: "sources/models/casc_config.aiml"

- model:
    name: CatalogEntry
    fields:
      - [job_id,      string]
      - [name,        string]
      # Welches exodus-Projekt dieser Job baut.  Die Bruecke zu kontor: ein
      # `package.published` nennt Projekte, cosmos startet Jobs (doc/spec/111 §111.6).
      - [project,     string]
      # Woher die Quelle stammt (Pfad relativ zur Katalogwurzel) — fuer
      # `plan` und fuer die Fehlermeldung, nicht fuer den Lauf: der Job traegt
      # die Quelle selbst.
      - [source_file, string]
      - [interval_s,  i32]
      - [enabled,     i32]
      # "kontor": der Job nimmt an Neubau-Kampagnen teil.
      - [triggers,    list<string>]
      # "catalog" = gehoert dem Katalog; ein Eintrag, der aus der Erklaerung
      # verschwindet, wird abgeschaltet (F106-6), nicht geloescht (F100-15).
      - [origin,      string]

# Die gelesene Erklaerung: was `plan`/`apply` vergleicht.
- model:
    name: CascDoc
    fields:
      - [has_config,  i32]
      - [config,      CascConfig]
      - [has_catalog, i32]
      - [jobs,        list<CatalogEntry>]
      # Quelltexte zu `jobs`, in derselben Reihenfolge (gelesen beim Parsen,
      # damit `plan` nichts mehr von der Platte holt).
      - [sources,     list<string>]
      - [errors,      list<string>]
