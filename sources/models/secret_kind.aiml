# Secrets for steps (doc/spec/115).
#
#   SecretKind      what config.secrets says about a secret besides its value
#                   (F115-2..5); stored in KV `casc_secret_kinds` (F115-4)
#   SecretKindSet   all of them, as one record — applied as a whole, like config.git
#   StageSecretRow  which names a stage binds to which env names (names only)
#
# The wire side (StepSecret, StepSecretSet) is in step_secret.aiml.
#
# Static-Check (aiml spec/49 §14): 3 models.

- model:
    name: SecretKind
    fields:
      - [name,        string]
      - [kind,        string]   # token | user_password | file | ssh_key | tls_client
      - [user,        string]
      - [passphrase,  string]   # the NAME of another secret (F115-3)
      - [cert,        string]   # paths on the server (F115-5)
      - [ca_cert,     string]
      - [known_hosts, string]

- model:
    name: SecretKindSet
    fields:
      - [kinds, list<SecretKind>]

- model:
    name: StageSecretRow
    fields:
      - [stage_id, string]
      - [binds,    string]      # "name:ENV,…" (aiml F62-165/166)
