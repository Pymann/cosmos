{
  "jobs": 16,
  "$schema": "exodus.project.config-1.0",
  "name": "client",
  "version": "0.0.1",
  "pre_compilation": "tools/stamp_build_version.aiml",
  "output_type": "wasm",
  "sources": [
    "sources/client/main.aiml"
  ],
  "asset_directories": [
    "assets"
  ],
  "compiler": {
    "name": "$AIML"
  },
  "linker": {
    "flags": [
      "-sASYNCIFY=1",
      "-sASYNCIFY_STACK_SIZE=1048576",
      "-sSTACK_SIZE=8388608",
      "-sEXPORTED_RUNTIME_METHODS=['UTF8ToString','ccall','cwrap','Asyncify']",
      "-sALLOW_MEMORY_GROWTH=1",
      "-sMAX_WEBGL_VERSION=2",
      "-sMIN_WEBGL_VERSION=2",
      "-sFULL_ES3=1",
      "-sASSERTIONS=2",
      "-g2",
      "-lwebsocket.js",
      "--shell-file=sources/client/web/shell.html"
    ],
    "library_paths": [
      "$AIML_VENV/lib/wasm32"
    ],
    "libraries": [
      "aiml_wasm"
    ]
  },
  "env": {
    "AIML_STRICT_TOPLEVEL": "1",
    "AIML_LIFETIME_DROPS": "1",
    "AIML_MEM_V3": "1"
  },
  "optimization": "0",
  "debug": false,
  "warnings": []
}
