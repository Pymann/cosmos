{
  "jobs": 16,
  "$schema": "exodus.project.config-1.0",
  "name": "ptrref_wasm",
  "version": "0.0.1",
  "output_type": "wasm",
  "sources": [
    "test/test_ptr_into_ref_param.aiml"
  ],
  "asset_directories": [],
  "compiler": {
    "name": "$AIML"
  },
  "linker": {
    "flags": [
      "-sASYNCIFY=1",
      "-sASYNCIFY_STACK_SIZE=131072",
      "-sSTACK_SIZE=8388608",
      "-sEXPORTED_RUNTIME_METHODS=['UTF8ToString','ccall','cwrap','Asyncify']",
      "-sALLOW_MEMORY_GROWTH=1",
      "-sMAX_WEBGL_VERSION=2",
      "-sMIN_WEBGL_VERSION=2",
      "-sFULL_ES3=1",
      "-sASSERTIONS=2",
      "-sSTACK_OVERFLOW_CHECK=2",
      "-sEXIT_RUNTIME=1",
      "-sENVIRONMENT=node",
      "-sNODERAWFS=1",
      "-g2",
      "-lwebsocket.js"
    ],
    "library_paths": [
      "$AIML_VENV/lib/wasm32"
    ],
    "libraries": [
      "aiml_wasm"
    ]
  },
  "env": {
    "AIML_STRICT_TOPLEVEL": "1",
    "AIML_LIFETIME_DROPS": "1",
    "AIML_MEM_V3": "1"
  },
  "optimization": "0",
  "debug": false,
  "warnings": []
}
