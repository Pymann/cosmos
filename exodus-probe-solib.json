{
    "$schema": "exodus.project.config-1.0",
    "name": "cosmos_probe_offer",
    "version": "0.1.0",
    "output_type": "shared_lib",
    "sources": ["probe/solib/offer.aiml"],
    "compiler": {
        "name": "$AIML",
        "lang_standard": "17",
        "flags": []
    },
    "linker": {
        "name": "g++",
        "libraries": ["aiml", "pthread", "dl"],
        "library_paths": ["$AIML_VENV/lib"]
    },
    "artifact_in_cwd": true,
    "optimization": "0",
    "debug": true,
    "env": { "AIML_MEM_V3": "1" }
}
