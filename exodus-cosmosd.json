{
    "$schema": "exodus.project.config-1.0",
    "name": "cosmosd",
    "version": "0.1.0",
    "output_type": "executable",
    "sources": ["sources/server/daemon_main.aiml"],
    "compiler": {
        "name": "$AIML",
        "version": { "ge": "1.0.2.8", "lt": "1.1" },
        "lang_standard": "17",
        "flags": []
    },
    "linker": {
        "name": "g++",
        "flags": [
            "-Wl,-rpath,$ORIGIN/../lib"
        ],
        "libraries": ["aiml", "pthread", "ssl", "crypto", "dl"],
        "library_paths": [
            "$AIML_VENV/lib"
        ]
    },
    "artifact_in_cwd": true,
    "optimization": "0",
    "debug": true,
    "warnings": [],
    "env": {
        "AIML_MEM_V3": "1"
    }
}
