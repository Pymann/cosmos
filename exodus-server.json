{
    "$schema": "exodus.project.config-1.0",
    "name": "server",
    "version": "0.1.0",
    "output_type": "executable",
    "sources": ["sources/server/server_main.aiml"],
    "compiler": {
        "name": "$AIML",
        "lang_standard": "17",
        "flags": []
    },
    "linker": {
        "name": "g++",
        "flags": [
            "-Wl,-rpath,$ORIGIN/../lib"
        ],
        "libraries": ["aiml", "pthread", "ssl", "crypto", "dl"],
        "library_paths": [
            "$AIML_VENV/lib"
        ]
    },
    "artifact_in_cwd": true,
    "optimization": "0",
    "debug": false,
    "warnings": []
}
